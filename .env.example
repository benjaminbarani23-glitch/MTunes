# Airwall configuration
# Copy to .env and adjust values

# --- Database & Cache ---
DATABASE_URL=postgresql+psycopg://airwall:airwall@localhost:5432/airwall
REDIS_URL=redis://localhost:6379/0

# --- API Keys ---
AIRWALL_API_KEY=dev-api-key-change-me
AIRWALL_ADMIN_API_KEY=dev-admin-key-change-me

# --- Risk Thresholds ---
# score 0-39 = allow, 40-79 = sandbox, 80-100 = block
RISK_ALLOW_MAX=39
RISK_SANDBOX_MAX=79

# --- Production LLM (Ollama) ---
# Point to your local Ollama instance
PRODUCTION_LLM_URL=http://localhost:11434
# Ollama doesn't require an API key, leave empty
PRODUCTION_LLM_API_KEY=

# --- Sandbox LLM (optional) ---
SANDBOX_LLM_URL=

# --- Logging ---
LOG_FULL_PROMPTS=false
